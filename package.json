    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/dotvet.js src/**/*.js"
  },
  "keywords": [
    "env",
    "dotenv",
    "security",
    "jwt",
    "secrets",
    "validation",
    "linter",
    "ci",
    "cli",
    "devsecops"
  ],
  "author": "EthicCode Technologies <hi@ethiccode.in>",

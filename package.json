{
  "name": "dotvet",
  "version": "0.1.5",
  "description": "Zero-config environment variable security scanner and quality gate CLI. Validates presence, bans placeholders, and enforces secret strength (e.g. JWT >= 32 chars).",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dotvet": "bin/dotvet.js"
  },
